+/// A diagnostic preview of the texture read by a compute shader, selected as
+/// VICTORY_PREVIEW_SRV=<hash>:<root table slot>:<dword offset>.
+pub(crate) fn preview_srv(shader: &str) -> Option<(usize, u32)> {
+    static CHOICE: std::sync::OnceLock<Option<(String, usize, u32)>> = std::sync::OnceLock::new();
+    let (hash, slot, offset) = CHOICE.get_or_init(|| {
+        let value = std::env::var("VICTORY_PREVIEW_SRV").ok()?;
+        let mut parts = value.split(':');
+        let choice = (parts.next()?.to_owned(), parts.next()?.parse().ok()?, parts.next()?.parse().ok()?);
+        parts.next().is_none().then_some(choice)
+    }).as_ref()?;
+    (shader == hash).then_some((*slot, *offset))
+}
+
+type Preview = std::sync::Arc<crate::resource::HostTexture>;
+static PREVIEW: std::sync::Mutex<Option<Preview>> = std::sync::Mutex::new(None);
+
+/// The selected dispatch was submitted. Hold its input until the next present.
+pub(crate) fn preview_after(list: &crate::host::HostList, resource: crate::object::This) {
+    if let Some(copy) = crate::resource::host_copy(resource) {
+        list.defer_after(move || {
+            *PREVIEW.lock().unwrap_or_else(|e| e.into_inner()) = Some(copy.clone());
+        });
+    }
+}
+
+pub(crate) fn take_preview() -> Option<Preview> {
+    PREVIEW.lock().unwrap_or_else(|e| e.into_inner()).take()
+}
