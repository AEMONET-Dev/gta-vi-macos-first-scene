+/// Copy the exact input bound to the material pass before later passes reuse the texture.
+pub(crate) fn material_input(list: &crate::host::HostList, texture: &ID3D12Resource, frame: u64, kind: &str) {
+    static SEQUENCE: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+    let Some(host) = crate::host::host() else { return };
+    let Some((buffer, footprint)) = read_back(&host.device, &list.list, texture) else { return };
+    let seq = SEQUENCE.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+    let name = format!("material-{frame}-{seq:03}-{kind}");
+    list.defer_after(move || {
+        let fp = footprint.Footprint;
+        let pitch = fp.RowPitch as usize;
+        let mut data = std::ptr::null_mut();
+        // SAFETY: the list has run and the footprint describes the readback allocation.
+        unsafe {
+            if buffer.Map(0, None, Some(&mut data)).is_err() { return; }
+            // GetCopyableFootprints can omit the padding after the final row.
+            let bytes = std::slice::from_raw_parts(data.cast(), buffer.GetDesc().Width as usize);
+            if let Some(rgba) = to_rgba(fp.Format.0 as u32, fp.Width as usize, fp.Height as usize, pitch, bytes) {
