+/// Tracks large bulk heap/memory ranges already queued for refresh in the
+/// current frame so multi-submission world frames under Rosetta (no page-fault
+/// watch) do not re-copy multi-hundred-MB bindless heaps 30+ times per frame.
+/// Explicit `Step::Refresh` calls are never deduplicated here.
+fn heap_swept_this_frame(
+    shadow: &std::sync::Arc<crate::shadow::Shadow>,
+    address: usize,
+    len: usize,
+) -> bool {
+    const LARGE: usize = 256 << 10;
+    if len < LARGE {
+        return false;
+    }
+    static SWEPT: std::sync::OnceLock<
+        Mutex<(u64, std::collections::HashSet<(usize, usize, usize)>)>,
+    > = std::sync::OnceLock::new();
+    let frame = crate::frame::current();
+    let mut guard = SWEPT
+        .get_or_init(|| Mutex::new((u64::MAX, std::collections::HashSet::new())))
+        .lock()
+        .unwrap_or_else(|e| e.into_inner());
+    if guard.0 != frame {
+        guard.0 = frame;
+        guard.1.clear();
+    }
+    !guard
+        .1
+        .insert((std::sync::Arc::as_ptr(shadow) as usize, address, len))
+}
