index 0000000000000000000000000000000000000000..07edcf07626dd82242670f78c5ec3c0a8b67424c
--- /dev/null
+++ b/crates/victory-metal/src/metal.rs
@@ -0,0 +1,422 @@
+//! Direct macOS `Metal.framework` FFI (zero external crates).
+//!
+//! Provides native Apple Silicon `MTLDevice`, `MTLCommandQueue`, `.metallib` loading,
+//! `MTLComputePipelineState`, unified-memory zero-copy `MTLBuffer`
+//! (`newBufferWithBytesNoCopy` / `MTLResourceStorageModeShared`), and GPU compute dispatch.
+
+use std::ffi::{CStr, CString, c_char, c_void};
+
+use anyhow::{Result, bail};
+
+#[link(name = "Metal", kind = "framework")]
+#[link(name = "Foundation", kind = "framework")]
+unsafe extern "C" {
+    fn MTLCreateSystemDefaultDevice() -> *mut c_void;
+    fn objc_getClass(name: *const c_char) -> *mut c_void;
+    fn sel_registerName(name: *const c_char) -> *mut c_void;
+    fn objc_msgSend();
+    fn dispatch_data_create(
+        buffer: *const c_void,
+        size: usize,
+        queue: *mut c_void,
+        destructor: *const c_void,
+    ) -> *mut c_void;
+    fn dispatch_release(object: *mut c_void);
+}
+
+/// `MTLResourceStorageModeShared` = 0 (Apple Silicon CPU+GPU unified memory).
+pub const MTL_RESOURCE_STORAGE_MODE_SHARED: usize = 0;
+
+#[repr(C)]
+#[derive(Debug, Clone, Copy)]
+pub struct MtlSize {
+    pub width: usize,
+    pub height: usize,
+    pub depth: usize,
+}
+
+fn sel(name: &str) -> *mut c_void {
+    let c = CString::new(name).unwrap();
+    // SAFETY: `c` is a valid NUL-terminated selector name.
+    unsafe { sel_registerName(c.as_ptr()) }
+}
+
+unsafe fn retain(obj: *mut c_void) -> *mut c_void {
+    if obj.is_null() {
+        return obj;
+    }
+    let f: unsafe extern "C" fn(*mut c_void, *mut c_void) -> *mut c_void =
+        unsafe { std::mem::transmute(objc_msgSend as *const ()) };
+    unsafe { f(obj, sel("retain")) }
+}
+
+unsafe fn release(obj: *mut c_void) {
+    if !obj.is_null() {
+        let f: unsafe extern "C" fn(*mut c_void, *mut c_void) =
+            unsafe { std::mem::transmute(objc_msgSend as *const ()) };
+        unsafe { f(obj, sel("release")) };
+    }
+}
+
+unsafe fn nsstring(s: &str) -> *mut c_void {
+    let cls = unsafe { objc_getClass(c"NSString".as_ptr()) };
+    let c = CString::new(s).unwrap();
+    let f: unsafe extern "C" fn(*mut c_void, *mut c_void, *const c_char) -> *mut c_void =
+        unsafe { std::mem::transmute(objc_msgSend as *const ()) };
+    unsafe { f(cls, sel("stringWithUTF8String:"), c.as_ptr()) }
+}
+
+unsafe fn nsstring_to_rust(ns: *mut c_void) -> String {
+    if ns.is_null() {
+        return String::new();
+    }
+    let f: unsafe extern "C" fn(*mut c_void, *mut c_void) -> *const c_char =
+        unsafe { std::mem::transmute(objc_msgSend as *const ()) };
+    let ptr = unsafe { f(ns, sel("UTF8String")) };
+    if ptr.is_null() {
+        String::new()
+    } else {
+        unsafe { CStr::from_ptr(ptr) }.to_string_lossy().into_owned()
+    }
+}
+
+unsafe fn nserror_desc(err: *mut c_void) -> String {
+    if err.is_null() {
+        return "unknown Metal error".to_string();
+    }
+    let f: unsafe extern "C" fn(*mut c_void, *mut c_void) -> *mut c_void =
+        unsafe { std::mem::transmute(objc_msgSend as *const ()) };
+    let desc = unsafe { f(err, sel("localizedDescription")) };
+    unsafe { nsstring_to_rust(desc) }
+}
+
+/// Owned handle to a native `MTLDevice`.
+pub struct MetalDevice {
+    raw: *mut c_void,
+}
+
+// SAFETY: `MTLDevice` is thread-safe per Apple Metal documentation.
+unsafe impl Send for MetalDevice {}
+// SAFETY: as above.
+unsafe impl Sync for MetalDevice {}
+
+impl Drop for MetalDevice {
+    fn drop(&mut self) {
+        // SAFETY: `self.raw` is an owned Objective-C object.
+        unsafe { release(self.raw) };
+    }
+}
+
+/// Owned handle to a native `MTLCommandQueue`.
+pub struct MetalQueue {
+    raw: *mut c_void,
+}
+
+impl Drop for MetalQueue {
+    fn drop(&mut self) {
+        // SAFETY: `self.raw` is an owned Objective-C object.
+        unsafe { release(self.raw) };
+    }
+}
+
+/// Owned handle to a native `MTLLibrary`.
+pub struct MetalLibrary {
+    raw: *mut c_void,
+}
+
+impl Drop for MetalLibrary {
+    fn drop(&mut self) {
+        // SAFETY: `self.raw` is an owned Objective-C object.
+        unsafe { release(self.raw) };
+    }
+}
+
+/// Owned handle to a native `MTLComputePipelineState`.
+pub struct MetalComputePipeline {
+    raw: *mut c_void,
+}
+
+impl Drop for MetalComputePipeline {
+    fn drop(&mut self) {
+        // SAFETY: `self.raw` is an owned Objective-C object.
+        unsafe { release(self.raw) };
+    }
+}
+
+/// Owned handle to a native `MTLBuffer` (shared or zero-copy unified memory).
+pub struct MetalBuffer {
+    raw: *mut c_void,
+    len: usize,
+}
+
+impl Drop for MetalBuffer {
+    fn drop(&mut self) {
+        // SAFETY: `self.raw` is an owned Objective-C object.
+        unsafe { release(self.raw) };
+    }
+}
+
+impl MetalDevice {
+    /// Returns the system default Apple Silicon `MTLDevice`.
+    pub fn system_default() -> Result<Self> {
+        // SAFETY: `MTLCreateSystemDefaultDevice` returns a +1 retained `MTLDevice` or null.
+        let raw = unsafe { MTLCreateSystemDefaultDevice() };
+        if raw.is_null() {
+            bail!("MTLCreateSystemDefaultDevice returned null");
+        }
+        Ok(Self { raw })
+    }
+
+    /// Returns the human-readable GPU name (e.g., `"Apple M5 Max"`).
+    pub fn name(&self) -> String {
+        // SAFETY: `[self.raw name]` returns an `NSString*`.
+        unsafe {
+            let f: unsafe extern "C" fn(*mut c_void, *mut c_void) -> *mut c_void =
+                std::mem::transmute(objc_msgSend as *const ());
+            let ns = f(self.raw, sel("name"));
+            nsstring_to_rust(ns)
+        }
+    }
+
+    /// Whether the GPU shares unified memory with the CPU (`hasUnifiedMemory`).
+    pub fn has_unified_memory(&self) -> bool {
+        // SAFETY: `[self.raw hasUnifiedMemory]` returns `BOOL` (`u8`).
+        unsafe {
+            let f: unsafe extern "C" fn(*mut c_void, *mut c_void) -> u8 =
+                std::mem::transmute(objc_msgSend as *const ());
+            f(self.raw, sel("hasUnifiedMemory")) != 0
+        }
+    }
+
+    /// Creates a native `MTLCommandQueue`.
+    pub fn new_command_queue(&self) -> Result<MetalQueue> {
+        // SAFETY: `[self.raw newCommandQueue]` returns a +1 retained `MTLCommandQueue`.
+        let raw = unsafe {
+            let f: unsafe extern "C" fn(*mut c_void, *mut c_void) -> *mut c_void =
+                std::mem::transmute(objc_msgSend as *const ());
+            f(self.raw, sel("newCommandQueue"))
+        };
+        if raw.is_null() {
+            bail!("newCommandQueue returned null");
+        }
+        Ok(MetalQueue { raw })
+    }
+
+    /// Loads a compiled `.metallib` binary into an `MTLLibrary`.
+    pub fn new_library_from_metallib(&self, metallib: &[u8]) -> Result<MetalLibrary> {
+        // SAFETY: `dispatch_data_create` with default destructor copies `metallib` safely;
+        // `newLibraryWithData:error:` returns a +1 retained `MTLLibrary`.
+        unsafe {
+            let data = dispatch_data_create(
+                metallib.as_ptr().cast(),
+                metallib.len(),
+                std::ptr::null_mut(),
+                std::ptr::null(),
+            );
+            let mut err: *mut c_void = std::ptr::null_mut();
+            let f: unsafe extern "C" fn(
+                *mut c_void,
+                *mut c_void,
+                *mut c_void,
+                *mut *mut c_void,
+            ) -> *mut c_void = std::mem::transmute(objc_msgSend as *const ());
+            let lib = f(self.raw, sel("newLibraryWithData:error:"), data, &mut err);
+            dispatch_release(data);
+            if lib.is_null() {
+                bail!("newLibraryWithData failed: {}", nserror_desc(err));
+            }
+            Ok(MetalLibrary { raw: lib })
+        }
+    }
+
+    /// Compiles Metal Shading Language (MSL) source directly into an `MTLLibrary`.
+    pub fn new_library_from_source(&self, source: &str) -> Result<MetalLibrary> {
+        // SAFETY: `newLibraryWithSource:options:error:` returns a +1 retained `MTLLibrary`.
+        unsafe {
+            let src = nsstring(source);
+            let mut err: *mut c_void = std::ptr::null_mut();
+            let f: unsafe extern "C" fn(
+                *mut c_void,
+                *mut c_void,
+                *mut c_void,
+                *mut c_void,
+                *mut *mut c_void,
+            ) -> *mut c_void = std::mem::transmute(objc_msgSend as *const ());
+            let lib = f(
+                self.raw,
+                sel("newLibraryWithSource:options:error:"),
+                src,
+                std::ptr::null_mut(),
+                &mut err,
+            );
+            if lib.is_null() {
+                bail!("newLibraryWithSource failed: {}", nserror_desc(err));
+            }
+            Ok(MetalLibrary { raw: lib })
+        }
+    }
+
+    /// Creates an `MTLComputePipelineState` from a function inside `library`.
+    pub fn new_compute_pipeline(
+        &self,
+        library: &MetalLibrary,
+        function_name: &str,
+    ) -> Result<MetalComputePipeline> {
+        // SAFETY: `[library newFunctionWithName:]` and `[device newComputePipelineStateWithFunction:error:]`
+        // each return +1 retained objects.
+        unsafe {
+            let name = nsstring(function_name);
+            let f_fn: unsafe extern "C" fn(*mut c_void, *mut c_void, *mut c_void) -> *mut c_void =
+                std::mem::transmute(objc_msgSend as *const ());
+            let func = f_fn(library.raw, sel("newFunctionWithName:"), name);
+            if func.is_null() {
+                bail!("Metal function '{function_name}' not found in library");
+            }
+            let mut err: *mut c_void = std::ptr::null_mut();
+            let f_pso: unsafe extern "C" fn(
+                *mut c_void,
+                *mut c_void,
+                *mut c_void,
+                *mut *mut c_void,
+            ) -> *mut c_void = std::mem::transmute(objc_msgSend as *const ());
+            let pso = f_pso(
+                self.raw,
+                sel("newComputePipelineStateWithFunction:error:"),
+                func,
+                &mut err,
+            );
+            release(func);
+            if pso.is_null() {
+                bail!(
+                    "newComputePipelineStateWithFunction failed: {}",
+                    nserror_desc(err)
+                );
+            }
+            Ok(MetalComputePipeline { raw: pso })
+        }
+    }
+
+    /// Allocates a unified-memory `MTLStorageModeShared` buffer.
+    pub fn new_buffer_shared(&self, len: usize) -> Result<MetalBuffer> {
+        // SAFETY: `[self.raw newBufferWithLength:options:]` returns a +1 retained `MTLBuffer`.
+        let raw = unsafe {
+            let f: unsafe extern "C" fn(*mut c_void, *mut c_void, usize, usize) -> *mut c_void =
+                std::mem::transmute(objc_msgSend as *const ());
+            f(
+                self.raw,
+                sel("newBufferWithLength:options:"),
+                len,
+                MTL_RESOURCE_STORAGE_MODE_SHARED,
+            )
+        };
+        if raw.is_null() {
+            bail!("newBufferWithLength({len}) returned null");
+        }
+        Ok(MetalBuffer { raw, len })
+    }
+
+    /// Wraps an existing page-aligned host RAM region as a **zero-copy** unified-memory
+    /// `MTLBuffer` (`newBufferWithBytesNoCopy:length:options:deallocator:`).
+    ///
+    /// # Safety
+    /// `ptr` must be page-aligned (`16 KiB` on Apple Silicon), `len` must be a non-zero
+    /// multiple of page size, and the backing memory must outlive the returned `MetalBuffer`.
+    pub unsafe fn new_buffer_no_copy(&self, ptr: *mut u8, len: usize) -> Result<MetalBuffer> {
+        let raw = unsafe {
+            let f: unsafe extern "C" fn(
+                *mut c_void,
+                *mut c_void,
+                *mut c_void,
+                usize,
+                usize,
+                *mut c_void,
+            ) -> *mut c_void = std::mem::transmute(objc_msgSend as *const ());
+            f(
+                self.raw,
+                sel("newBufferWithBytesNoCopy:length:options:deallocator:"),
+                ptr.cast(),
+                len,
+                MTL_RESOURCE_STORAGE_MODE_SHARED,
+                std::ptr::null_mut(),
+            )
+        };
+        if raw.is_null() {
+            bail!("newBufferWithBytesNoCopy({ptr:?}, {len}) returned null");
+        }
+        Ok(MetalBuffer { raw, len })
+    }
+}
+
+impl MetalBuffer {
+    pub fn len(&self) -> usize {
+        self.len
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.len == 0
+    }
+
+    /// Direct CPU pointer into the shared/zero-copy GPU buffer (`[buffer contents]`).
+    pub fn contents(&self) -> *mut u8 {
+        // SAFETY: `[self.raw contents]` returns the mapped CPU pointer for shared buffers.
+        unsafe {
+            let f: unsafe extern "C" fn(*mut c_void, *mut c_void) -> *mut c_void =
+                std::mem::transmute(objc_msgSend as *const ());
+            f(self.raw, sel("contents")).cast::<u8>()
+        }
+    }
+}
+
+impl MetalQueue {
+    /// Encodes and synchronously executes a single 1D/3D compute dispatch on the GPU.
+    pub fn dispatch_compute_sync(
+        &self,
+        pso: &MetalComputePipeline,
+        buffers: &[&MetalBuffer],
+        grid: MtlSize,
+        threads: MtlSize,
+    ) -> Result<()> {
+        // SAFETY: standard Metal command buffer / compute encoder lifecycle.
+        unsafe {
+            let f0: unsafe extern "C" fn(*mut c_void, *mut c_void) -> *mut c_void =
+                std::mem::transmute(objc_msgSend as *const ());
+            let cmd = retain(f0(self.raw, sel("commandBuffer")));
+            if cmd.is_null() {
+                bail!("commandBuffer returned null");
+            }
+            let enc = retain(f0(cmd, sel("computeCommandEncoder")));
+            if enc.is_null() {
+                release(cmd);
+                bail!("computeCommandEncoder returned null");
+            }
+            let f_pso: unsafe extern "C" fn(*mut c_void, *mut c_void, *mut c_void) =
+                std::mem::transmute(objc_msgSend as *const ());
+            f_pso(enc, sel("setComputePipelineState:"), pso.raw);
+
+            let f_buf: unsafe extern "C" fn(*mut c_void, *mut c_void, *mut c_void, usize, usize) =
+                std::mem::transmute(objc_msgSend as *const ());
+            for (idx, buf) in buffers.iter().enumerate() {
+                f_buf(enc, sel("setBuffer:offset:atIndex:"), buf.raw, 0, idx);
+            }
+
+            let f_disp: unsafe extern "C" fn(*mut c_void, *mut c_void, MtlSize, MtlSize) =
+                std::mem::transmute(objc_msgSend as *const ());
+            f_disp(
+                enc,
+                sel("dispatchThreadgroups:threadsPerThreadgroup:"),
+                grid,
+                threads,
+            );
+
+            let f_void: unsafe extern "C" fn(*mut c_void, *mut c_void) =
+                std::mem::transmute(objc_msgSend as *const ());
+            f_void(enc, sel("endEncoding"));
+            release(enc);
+
+            f_void(cmd, sel("commit"));
+            f_void(cmd, sel("waitUntilCompleted"));
+            release(cmd);
+            Ok(())
+        }
+    }
+}
diff --git a/crates/victory-metal/src/watch.rs b/crates/victory-metal/src/watch.rs
new file mode 100644
index 0000000000000000000000000000000000000000..9743ec89b4098ef24274fe19bb647701a7d94afa
--- /dev/null
+++ b/crates/victory-metal/src/watch.rs
@@ -0,0 +1,229 @@
+//! Native macOS dirty-page tracker (`mprotect` + `SIGBUS`/`SIGSEGV` handler).
+//!
+//! Under Wine + Rosetta 2, Windows `VirtualProtect` page-fault tracking fails, forcing
+//! VIctory to re-copy 15–99 GB/frame whole. On native macOS, `mprotect(PROT_READ)` +
+//! `sigaction` tracks exact 16 KiB Apple Silicon dirty pages with near-zero overhead.
+
+use std::ffi::{c_int, c_void};
+use std::sync::atomic::{AtomicU64, AtomicUsize, Ordering};
+use std::sync::{Mutex, Once};
+
+use anyhow::{Result, bail};
+
+const PROT_READ: c_int = 0x1;
+const PROT_WRITE: c_int = 0x2;
+const MAP_PRIVATE: c_int = 0x0002;
+const MAP_ANON: c_int = 0x1000;
+const SIGBUS: c_int = 10;
+const SIGSEGV: c_int = 11;
+const SA_SIGINFO: c_int = 0x0040;
+const _SC_PAGESIZE: c_int = 29;
+
+#[repr(C)]
+struct SigAction {
+    sa_sigaction: usize,
+    sa_mask: u32,
+    sa_flags: c_int,
+}
+
+#[repr(C)]
+struct SigInfo {
+    si_signo: c_int,
+    si_errno: c_int,
+    si_code: c_int,
+    si_pid: i32,
+    si_uid: u32,
+    si_status: c_int,
+    si_addr: *mut c_void,
+}
+
+unsafe extern "C" {
+    fn sysconf(name: c_int) -> isize;
+    fn mmap(
+        addr: *mut c_void,
+        len: usize,
+        prot: c_int,
+        flags: c_int,
+        fd: c_int,
+        offset: i64,
+    ) -> *mut c_void;
+    fn munmap(addr: *mut c_void, len: usize) -> c_int;
+    fn mprotect(addr: *mut c_void, len: usize, prot: c_int) -> c_int;
+    fn sigaction(sig: c_int, act: *const SigAction, oact: *mut SigAction) -> c_int;
+}
+
+/// Returns the macOS hardware page size (16,384 bytes on Apple Silicon).
+pub fn page_size() -> usize {
+    // SAFETY: `sysconf(_SC_PAGESIZE)` is a standard read-only POSIX query.
+    let ps = unsafe { sysconf(_SC_PAGESIZE) };
+    if ps > 0 { ps as usize } else { 16384 }
+}
+
+// Single active watched region registry (signal-safe atomics for zero-lock fault handling).
+static WATCH_BASE: AtomicUsize = AtomicUsize::new(0);
+static WATCH_LEN: AtomicUsize = AtomicUsize::new(0);
+static WATCH_PAGE: AtomicUsize = AtomicUsize::new(16384);
+static WATCH_BITMAP_PTR: AtomicUsize = AtomicUsize::new(0);
+static WATCH_FAULTS: AtomicU64 = AtomicU64::new(0);
+static INSTALL_ONCE: Once = Once::new();
+static WATCH_LOCK: Mutex<()> = Mutex::new(());
+
+unsafe extern "C" fn fault_handler(sig: c_int, info: *mut SigInfo, _ctx: *mut c_void) {
+    if info.is_null() {
+        std::process::abort();
+    }
+    // SAFETY: `info` is provided by the Darwin kernel for `SA_SIGINFO` handlers.
+    let addr = unsafe { (*info).si_addr as usize };
+    let base = WATCH_BASE.load(Ordering::Acquire);
+    let len = WATCH_LEN.load(Ordering::Acquire);
+    if base != 0 && addr >= base && addr < base + len {
+        let ps = WATCH_PAGE.load(Ordering::Relaxed);
+        let page = (addr - base) / ps;
+        let page_addr = base + page * ps;
+        let bmp = WATCH_BITMAP_PTR.load(Ordering::Acquire) as *const AtomicU64;
+        if !bmp.is_null() {
+            // SAFETY: `page / 64` is within the allocated bitmap for `[base, base + len)`.
+            unsafe {
+                (*bmp.add(page / 64)).fetch_or(1u64 << (page % 64), Ordering::Release);
+            }
+        }
+        WATCH_FAULTS.fetch_add(1, Ordering::Relaxed);
+        // SAFETY: `page_addr` is page-aligned inside our `mmap` region; `mprotect` is
+        // async-signal-safe on Darwin.
+        let rc = unsafe { mprotect(page_addr as *mut c_void, ps, PROT_READ | PROT_WRITE) };
+        if rc == 0 {
+            return;
+        }
+    }
+    let _ = sig;
+    std::process::abort();
+}
+
+fn install_handlers() {
+    INSTALL_ONCE.call_once(|| {
+        let act = SigAction {
+            sa_sigaction: fault_handler as *const () as usize,
+            sa_mask: 0,
+            sa_flags: SA_SIGINFO,
+        };
+        // SAFETY: installs our `SA_SIGINFO` handler for `SIGBUS` and `SIGSEGV`.
+        unsafe {
+            sigaction(SIGBUS, &act, std::ptr::null_mut());
+            sigaction(SIGSEGV, &act, std::ptr::null_mut());
+        }
+    });
+}
+
+/// A page-aligned `mmap` region with native macOS write-watch dirty-page tracking.
+///
+/// The backing memory is also page-aligned so it can be passed directly to
+/// [`crate::metal::MetalDevice::new_buffer_no_copy`] for zero-copy GPU access!
+pub struct WatchedRegion {
+    base: *mut u8,
+    len: usize,
+    page_size: usize,
+    bitmap: Box<[AtomicU64]>,
+    _guard: std::sync::MutexGuard<'static, ()>,
+}
+
+impl WatchedRegion {
+    /// Allocates `pages * page_size()` bytes of page-aligned RAM and enables write-watch.
+    pub fn new(pages: usize) -> Result<Self> {
+        let guard = WATCH_LOCK.lock().unwrap_or_else(|e| e.into_inner());
+        install_handlers();
+        let ps = page_size();
+        let len = pages
+            .checked_mul(ps)
+            .ok_or_else(|| anyhow::anyhow!("region size overflow"))?;
+        // SAFETY: anonymous private `mmap` allocation.
+        let ptr = unsafe {
+            mmap(
+                std::ptr::null_mut(),
+                len,
+                PROT_READ | PROT_WRITE,
+                MAP_PRIVATE | MAP_ANON,
+                -1,
+                0,
+            )
+        };
+        if ptr.is_null() || (ptr as isize) == -1 {
+            bail!("mmap({len}) failed");
+        }
+        let words = pages.div_ceil(64);
+        let bitmap: Box<[AtomicU64]> = (0..words)
+            .map(|_| AtomicU64::new(0))
+            .collect::<Vec<_>>()
+            .into_boxed_slice();
+        WATCH_PAGE.store(ps, Ordering::Relaxed);
+        WATCH_BITMAP_PTR.store(bitmap.as_ptr() as usize, Ordering::Release);
+        WATCH_BASE.store(ptr as usize, Ordering::Release);
+        WATCH_LEN.store(len, Ordering::Release);
+        Ok(Self {
+            base: ptr.cast::<u8>(),
+            len,
+            page_size: ps,
+            bitmap,
+            _guard: guard,
+        })
+    }
+
+    pub fn as_mut_ptr(&self) -> *mut u8 {
+        self.base
+    }
+
+    pub fn len(&self) -> usize {
+        self.len
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.len == 0
+    }
+
+    pub fn page_size(&self) -> usize {
+        self.page_size
+    }
+
+    /// Marks the entire region read-only (`PROT_READ`) and clears dirty bits.
+    pub fn arm(&self) -> Result<()> {
+        for w in &self.bitmap {
+            w.store(0, Ordering::Release);
+        }
+        // SAFETY: `self.base..self.base+self.len` is our page-aligned `mmap` region.
+        let rc = unsafe { mprotect(self.base.cast(), self.len, PROT_READ) };
+        if rc != 0 {
+            bail!("mprotect(PROT_READ) failed with {rc}");
+        }
+        Ok(())
+    }
+
+    /// Returns the list of dirty page indices written since the last [`Self::arm`].
+    pub fn take_dirty_pages(&self) -> Vec<usize> {
+        let mut dirty = Vec::new();
+        for (wi, word) in self.bitmap.iter().enumerate() {
+            let mut bits = word.swap(0, Ordering::AcqRel);
+            while bits != 0 {
+                let bit = bits.trailing_zeros() as usize;
+                dirty.push(wi * 64 + bit);
+                bits &= bits - 1;
+            }
+        }
+        dirty
+    }
+
+    pub fn total_faults() -> u64 {
+        WATCH_FAULTS.load(Ordering::Relaxed)
+    }
+}
+
+impl Drop for WatchedRegion {
+    fn drop(&mut self) {
+        WATCH_BASE.store(0, Ordering::Release);
+        WATCH_LEN.store(0, Ordering::Release);
+        WATCH_BITMAP_PTR.store(0, Ordering::Release);
+        // SAFETY: `self.base` was returned by `mmap(len)`.
+        unsafe {
+            let _ = mprotect(self.base.cast(), self.len, PROT_READ | PROT_WRITE);
+            let _ = munmap(self.base.cast(), self.len);
+        }
+    }
+}
diff --git a/crates/victory-metal/tests/native_m5_e2e.rs b/crates/victory-metal/tests/native_m5_e2e.rs
