+    /// A local test can submit one confirmed action at a time through a file.
+    /// Consume the request before holding it for 200 ms, so it cannot repeat.
+    #[cfg(feature = "diagnostics")]
+    fn local_test_key() -> Option<u8> {
+        use std::path::PathBuf;
+        use std::sync::Mutex;
+        static PATH: LazyLock<Option<PathBuf>> =
+            LazyLock::new(|| std::env::var_os("VICTORY_TEST_KEY_FILE").map(PathBuf::from));
+        static STATE: Mutex<(Option<Instant>, Option<(Instant, u8)>)> = Mutex::new((None, None));
+        let path = PATH.as_ref()?;
+        let now = Instant::now();
+        let mut state = STATE.lock().unwrap_or_else(|error| error.into_inner());
+        if let Some((until, key)) = state.1 {
+            if now < until {
+                return Some(key);
+            }
+            state.1 = None;
+        }
+        if state.0.is_some_and(|next| now < next) {
+            return None;
+        }
+        state.0 = Some(now + Duration::from_millis(100));
+        let request = std::fs::read_to_string(path).ok()?;
+        std::fs::remove_file(path).ok()?;
+        let key = match request.trim() {
+            "Enter" => 0x0d,
+            "Esc" => 0x1b,
+            "Up" => 0x26,
+            "Down" => 0x28,
+            "Left" => 0x25,
+            "Right" => 0x27,
+            _ => return None,
+        };
+        state.1 = Some((now + Duration::from_millis(200), key));
+        tracing::info!(action = request.trim(), "local test input received");
+        Some(key)
     }
 
