+/// Compare display planes from the same presentation before the window scales them.
+pub(crate) fn dump_other_planes(frame: u64, planes: &[Vec<crate::object::This>], shown: usize) {
+    let blend_inputs = crate::switch::on("VICTORY_CAPTURE_BLEND_INPUTS");
+    if !listed(frame) || folder().is_none() || !(blend_inputs || crate::switch::on("VICTORY_CAPTURE_PLANES")) { return; }
+    let Some(host) = crate::host::host() else { return };
+    for (i, plane) in planes.iter().enumerate().filter(|(i, _)| blend_inputs || *i != shown) {
+        let Some(&resource) = plane.first() else { continue };
+        let Some(copy) = crate::resource::host_copy(resource) else { continue };
+        let state = copy.state.load(std::sync::atomic::Ordering::Relaxed);
+        // SAFETY: the texture is held by the present and the host copy.
+        let desc = unsafe { copy.texture.GetDesc() };
+        dump_one(host, &copy.texture, state, &format!("plane-{i}-frame-{frame}"), (i, resource, ""), &desc);
