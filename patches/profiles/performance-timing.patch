+    /// The point of the patch: a patched store into a read-only page
+    /// faults on a plain store, a handler makes the page writable, and the
+    /// store resumes. The original masked store would hang Rosetta here
+    /// (#14), so it is never run this way.
+    #[cfg(all(windows, target_arch = "x86_64"))]
+    #[test]
+    fn a_patched_store_resumes_after_a_write_fault() {
+        use windows_sys::Win32::Foundation::EXCEPTION_ACCESS_VIOLATION;
+        use windows_sys::Win32::System::Diagnostics::Debug::*;
+        use windows_sys::Win32::System::Memory::*;
+        static PAGE: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+        unsafe extern "system" fn unguard(info: *mut EXCEPTION_POINTERS) -> i32 {
+            // SAFETY: the system passes valid pointers.
+            unsafe {
+                let r = &*(*info).ExceptionRecord;
+                let page = PAGE.load(std::sync::atomic::Ordering::Relaxed);
+                if r.ExceptionCode == EXCEPTION_ACCESS_VIOLATION
+                    && (r.ExceptionInformation[1] & !0xfff) == page
+                {
+                    let mut old = 0;
+                    VirtualProtect(page as *const _, 0x1000, PAGE_READWRITE, &mut old);
+                    return -1; // EXCEPTION_CONTINUE_EXECUTION
+                }
+            }
+            0
+        }
+        let store = [0xc4, 0xe2, 0x75, 0x8e, 0x11]; // vpmaskmovd [rcx], ymm1, ymm2
+        let mut code = vec![0xc5, 0xfe, 0x6f, 0x0a, 0xc4, 0xc1, 0x7e, 0x6f, 0x10];
+        let site_at = code.len();
+        code.extend_from_slice(&store);
+        code.extend_from_slice(&[0xc5, 0xf8, 0x77, 0xc3]);
+        // SAFETY: our own pages and handler.
+        unsafe {
+            let exec = VirtualAlloc(
+                std::ptr::null(),
+                1 << 16,
+                MEM_RESERVE | MEM_COMMIT,
+                PAGE_EXECUTE_READWRITE,
+            ) as *mut u8;
+            std::ptr::copy_nonoverlapping(code.as_ptr(), exec, code.len());
+            let s = decode_store(&code, site_at).unwrap();
+            let site = exec as u64 + site_at as u64;
+            let at = exec as u64 + 0x1000;
+            let t = trampoline(&s, site, at).unwrap();
+            std::ptr::copy_nonoverlapping(t.as_ptr(), at as *mut u8, t.len());
+            let j = jump(site, s.len, at).unwrap();
+            std::ptr::copy_nonoverlapping(j.as_ptr(), site as *mut u8, j.len());
+            let data = VirtualAlloc(
+                std::ptr::null(),
+                0x1000,
+                MEM_RESERVE | MEM_COMMIT,
+                PAGE_READONLY,
+            ) as *mut u32;
+            PAGE.store(data as usize, std::sync::atomic::Ordering::Relaxed);
+            let handler = AddVectoredExceptionHandler(1, Some(unguard));
+            let f: extern "win64" fn(*mut u32, *const u32, *const u32) = std::mem::transmute(exec);
+            let mask: [u32; 8] = [0, 0x8000_0000, 0, 0, 0, 0, 0, 0x8000_0000];
+            let src: [u32; 8] = [1, 2, 3, 4, 5, 6, 7, 8];
+            f(data, mask.as_ptr(), src.as_ptr());
+            RemoveVectoredExceptionHandler(handler);
+            let got = std::slice::from_raw_parts(data, 8).to_vec();
+            assert_eq!(got, vec![0, 2, 0, 0, 0, 0, 0, 8]);
+            VirtualFree(data.cast(), 0, MEM_RELEASE);
+            VirtualFree(exec.cast(), 0, MEM_RELEASE);
+        }
+    }
+
+    /// The stores the crossing reproducer runs: `[rcx]` destination, mask
+    /// (or source for the unmasked kinds) in ymm1, source in ymm2.
+    #[cfg(all(windows, target_arch = "x86_64"))]
+    const CROSSING: [(&str, &[u8]); 6] = [
+        ("vpmaskmovd ymm", &[0xc4, 0xe2, 0x75, 0x8e, 0x11]),
+        ("vpmaskmovq ymm", &[0xc4, 0xe2, 0xf5, 0x8e, 0x11]),
+        ("vmaskmovps ymm", &[0xc4, 0xe2, 0x75, 0x2e, 0x11]),
+        ("vmaskmovpd ymm", &[0xc4, 0xe2, 0x75, 0x2f, 0x11]),
+        ("vcvtps2ph ymm", &[0xc4, 0xe3, 0x7d, 0x1d, 0x09, 0x00]),
+        ("vextractf128", &[0xc4, 0xe3, 0x7d, 0x19, 0x09, 0x01]),
+    ];
+
+    /// Guard state for the crossing reproducer: the 64 KiB block made
+    /// read-only (as `victory-gpu/src/watch.rs` guards title memory) and
+    /// how many write faults opened it.
+    #[cfg(all(windows, target_arch = "x86_64"))]
+    static GUARDED: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+    #[cfg(all(windows, target_arch = "x86_64"))]
+    static FAULTS: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+
+    #[cfg(all(windows, target_arch = "x86_64"))]
+    unsafe extern "system" fn open_block(
+        info: *mut windows_sys::Win32::System::Diagnostics::Debug::EXCEPTION_POINTERS,
+    ) -> i32 {
+        use std::sync::atomic::Ordering::SeqCst;
+        use windows_sys::Win32::Foundation::EXCEPTION_ACCESS_VIOLATION;
+        use windows_sys::Win32::System::Memory::{PAGE_READWRITE, VirtualProtect};
+        // SAFETY: the system passes the exception being dispatched.
+        unsafe {
+            let r = &*(*info).ExceptionRecord;
+            let block = GUARDED.load(SeqCst);
+            let at = r.ExceptionInformation[1];
+            if r.ExceptionCode == EXCEPTION_ACCESS_VIOLATION
+                && r.ExceptionInformation[0] == 1
+                && block != 0
+                && (block..block + 0x10000).contains(&at)
+            {
+                let mut old = 0;
+                VirtualProtect(block as *const _, 0x10000, PAGE_READWRITE, &mut old);
+                FAULTS.fetch_add(1, SeqCst);
+                return -1; // EXCEPTION_CONTINUE_EXECUTION
+            }
+        }
+        0
+    }
+
+    /// Code for `f(dst rcx, mask rdx, src r8)`: loads ymm1 and ymm2, runs
+    /// `store`, and returns; patched with the real trampoline when asked.
+    #[cfg(all(windows, target_arch = "x86_64"))]
+    unsafe fn crossing_code(store: &[u8], patch: bool) -> *mut u8 {
+        use windows_sys::Win32::System::Memory::*;
+        let mut code = vec![0x31, 0xc0, 0xc5, 0xfe, 0x6f, 0x0a, 0xc4, 0xc1, 0x7e, 0x6f, 0x10];
+        let site_at = code.len();
+        code.extend_from_slice(store);
+        code.extend_from_slice(&[0xc5, 0xf8, 0x77, 0xc3]);
+        // SAFETY: our own executable pages, written before they run.
+        unsafe {
+            let exec = VirtualAlloc(std::ptr::null(), 1 << 16, MEM_RESERVE | MEM_COMMIT, PAGE_EXECUTE_READWRITE) as *mut u8;
+            std::ptr::copy_nonoverlapping(code.as_ptr(), exec, code.len());
+            if patch {
+                let s = decode_store(&code, site_at).expect("decodes");
+                let site = exec as u64 + site_at as u64;
+                let at = exec as u64 + 0x1000;
+                let t = trampoline(&s, site, at).expect("trampoline");
+                std::ptr::copy_nonoverlapping(t.as_ptr(), at as *mut u8, t.len());
+                let j = jump(site, s.len, at).expect("jump");
+                std::ptr::copy_nonoverlapping(j.as_ptr(), site as *mut u8, j.len());
+            }
+            exec
+        }
+    }
+
+    /// Runs `store` with its destination `back` bytes before the start of
+    /// a 64 KiB block, the block guarded when `guard`; returns the 64 bytes
+    /// around the boundary and the faults taken.
+    #[cfg(all(windows, target_arch = "x86_64"))]
+    unsafe fn crossing_run(store: &[u8], patch: bool, back: usize, guard: bool) -> ([u8; 64], usize) {
+        use std::sync::atomic::Ordering::SeqCst;
+        use windows_sys::Win32::System::Diagnostics::Debug::*;
+        use windows_sys::Win32::System::Memory::*;
+        // SAFETY: our own pages and handler.
+        unsafe {
+            let exec = crossing_code(store, patch);
+            let data = VirtualAlloc(std::ptr::null(), 2 << 16, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE) as *mut u8;
+            std::ptr::write_bytes(data, 0x5a, 2 << 16);
+            let block = data.add(1 << 16);
+            FAULTS.store(0, SeqCst);
+            let handler = AddVectoredExceptionHandler(1, Some(open_block));
+            if guard {
+                let mut old = 0;
+                assert_ne!(VirtualProtect(block.cast(), 1 << 16, PAGE_READONLY, &mut old), 0);
+                GUARDED.store(block as usize, SeqCst);
+            }
+            let f: extern "win64" fn(*mut u8, *const u32, *const u32) = std::mem::transmute(exec);
+            let mask = [0x8000_0000u32; 8];
+            let src: [u32; 8] = [0x3f80_0001, 0x4000_0002, 0x4040_0003, 0x4080_0004, 0x40a0_0005, 0x40c0_0006, 0x40e0_0007, 0x4100_0008];
+            f(block.sub(back), mask.as_ptr(), src.as_ptr());
+            GUARDED.store(0, SeqCst);
+            RemoveVectoredExceptionHandler(handler);
+            let mut around = [0u8; 64];
+            std::ptr::copy_nonoverlapping(block.sub(32), around.as_mut_ptr(), 64);
+            VirtualFree(data.cast(), 0, MEM_RELEASE);
+            VirtualFree(exec.cast(), 0, MEM_RELEASE);
+            (around, FAULTS.load(SeqCst))
+        }
+    }
+
+    /// The Rosetta hang (#1, #50): a store that starts in writable memory
+    /// and runs into a guarded block. Patched, every kind at every 4-byte
+    /// offset over the boundary writes exactly what the original store
+    /// writes into unguarded memory, taking the fault a plain store takes.
+    #[cfg(all(windows, target_arch = "x86_64"))]
+    #[test]
+    fn patched_stores_crossing_into_a_guarded_block_resume() {
+        let mut crossing_cases = 0;
+        for (name, store) in CROSSING {
+            for back in (4..=32).step_by(4) {
+                // SAFETY: test-owned memory and code.
+                let (want, _) = unsafe { crossing_run(store, false, back, false) };
+                let (got, faults) = unsafe { crossing_run(store, true, back, true) };
+                assert_eq!(got, want, "{name}, {back} bytes before the guarded block");
+                let wrote_past = want[32..].iter().any(|&b| b != 0x5a);
+                assert_eq!(faults > 0, wrote_past, "{name}, {back} bytes before: faults {faults}");
+                crossing_cases += usize::from(wrote_past);
+                println!("{name:16} start -{back:2}: {} bytes compared, {faults} fault(s), crossing {wrote_past}", got.len());
+            }
+        }
+        println!("{crossing_cases} crossing cases resumed and matched");
+        assert!(crossing_cases >= 20);
+    }
+
+    /// The unpatched original of the reproducer (`REPRO_KIND` picks the
+    /// store, 0 = vpmaskmovd): under Rosetta this hangs with "unexpectedly
+    /// need to EmulateForward on a synchronous exception". Run alone, with
+    /// a timeout.
+    #[cfg(all(windows, target_arch = "x86_64"))]
+    #[test]
+    #[ignore]
+    fn unpatched_store_crossing_into_a_guarded_block() {
+        let kind: usize = std::env::var("REPRO_KIND").ok().and_then(|v| v.parse().ok()).unwrap_or(0);
+        let (name, store) = CROSSING[kind];
+
+        // SAFETY: test-owned memory and code.
+        let back = if store[2] & 0x04 != 0 && matches!(store[3], 0x1d | 0x19) { 8 } else { 16 };
+        let (_, faults) = unsafe { crossing_run(store, false, back, true) };
+        println!("unpatched {name} finished with {faults} fault(s)");
+    }
+}
