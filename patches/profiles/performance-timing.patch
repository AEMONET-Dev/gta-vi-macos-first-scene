+pub(crate) fn audit_note(what: Audit, at: usize) {
+    use std::sync::atomic::Ordering::Relaxed;
+    let k = match what {
+        Audit::Same => 0,
+        Audit::Raced => 1,
+        Audit::Missed(words) => {
