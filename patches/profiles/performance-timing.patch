+                    .unwrap_or_default();
+                tracing::error!(page = format_args!("{at:#x}"), words, aliases = ?others, "track audit: MISSED WRITE");
+            }
+            2
+        }
+        Audit::Skipped => 3,
+        Audit::Unreadable => 4,
+    };
+    AUDIT[k].fetch_add(1, Relaxed);
+}
