+fn coalesce_generic_rows(elements: &mut Vec<container::SigElement>) {
+    use std::collections::BTreeMap;
+    // Group indices by hardware register row for eligible generic (`kind == 0`)
+    // f32 rows. Excluding system values (`kind != 0`, e.g. `SV_IsFrontFace` on
+    // a pixel input row) ensures mesh and pixel stages agree on `VREG<row>`.
+    // Restrict to `comp == 9` (f32) so integer semantics (e.g. `COLOR0` u32)
+    // keep their original names and never mismatch across stages.
+    let mut by_row: BTreeMap<u32, Vec<usize>> = BTreeMap::new();
+    for (idx, e) in elements.iter().enumerate() {
+        if e.kind == 0
+            && let Some(r) = e.row
+        {
+            by_row.entry(r).or_default().push(idx);
+        }
+    }
+    let mut coalesced: BTreeMap<u32, container::SigElement> = BTreeMap::new();
+    for (&r, idxs) in &by_row {
+        let first = &elements[idxs[0]];
+        let all_f32 = idxs.iter().all(|&i| {
+            let e = &elements[i];
+            e.kind == 0 && e.comp == 9 && e.interp == first.interp
+        });
+        if !all_f32 {
+            continue;
+        }
+        let any_half = idxs.iter().any(|&i| elements[i].half);
+        if any_half && idxs.len() > 1 {
+            continue;
+        }
+        let max_end = idxs
+            .iter()
+            .map(|&i| elements[i].col + elements[i].cols)
+            .max()
+            .unwrap_or(0)
+            .min(4);
+        if max_end == 0 {
+            continue;
+        }
+        coalesced.insert(
+            r,
+            container::SigElement {
+                name: "VREG".to_owned(),
+                index: r,
+                kind: 0,
+                comp: first.comp,
+                interp: first.interp,
+                row: Some(r),
+                col: if any_half { first.col } else { 0 },
+                cols: if any_half { first.cols } else { max_end },
+                usage: 0,
+                half: any_half,
+            },
+        );
+    }
+    if coalesced.is_empty() {
+        return;
+    }
+    let mut out = Vec::with_capacity(elements.len());
+    let mut emitted = std::collections::HashSet::new();
+    for e in elements.drain(..) {
+        if e.kind == 0
+            && let Some(r) = e.row
+            && let Some(merged) = coalesced.get(&r)
+        {
+            if emitted.insert(r) {
+                out.push(merged.clone());
+            }
+            continue;
+        }
+        out.push(e);
+    }
+    *elements = out;
+}
