+
+/// This thread's note list, the next of `NOTES` for a new thread.
+fn mine() -> usize {
+    MINE.with(|mine| {
+        let mut at = mine.get();
+        if at == usize::MAX {
+            static NEXT: AtomicU64 = AtomicU64::new(0);
+            at = NEXT.fetch_add(1, Relaxed) as usize % SHARDS;
+            mine.set(at);
+        }
+        at
+    })
+}
 
