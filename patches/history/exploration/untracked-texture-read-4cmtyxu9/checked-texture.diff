+/// Take a checked snapshot of the title mapping. Streaming can unmap a page
+/// during the read. Keep the last complete image until a whole read succeeds.
+fn read_changed(last: &mut Vec<u8>, memory: *const u8, size: usize) -> Option<bool> {
+    use std::cell::RefCell;
+    thread_local! { static SCRATCH: RefCell<Vec<u8>> = const { RefCell::new(Vec::new()) }; }
+    SCRATCH.with_borrow_mut(|scratch| {
+        if scratch.len() < size {
+            scratch.resize(size, 0);
+        }
+        if !crate::host::read_into(memory, &mut scratch[..size]) {
+            return None;
+        }
+        if same_texels(last, &scratch[..size]) {
+            return Some(false);
+        }
+        scratch.truncate(size);
+        std::mem::swap(last, scratch);
+        Some(true)
+    })
 }
 
