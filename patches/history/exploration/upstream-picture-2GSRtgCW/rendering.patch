+impl CopyLocation {
+    /// A placed footprint in `resource` (tests).
+    pub(crate) fn placed(resource: This, footprint: crate::resource::PlacedFootprint) -> Self {
+        Self { resource, kind: 1, footprint }
+    }
+    /// Subresource 0 of `resource` (tests).
