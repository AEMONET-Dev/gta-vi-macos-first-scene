+/// The first slice of each requested range goes first, so the tail of one large
+/// resource cannot queue ahead of independent resources. Later rounds take one
+/// disjoint slice per large range, in the same order. Slice boundaries only
+/// guide checked reads; committed, unmapped and changed pages retain the
+/// ordinary `Shadow::update` / `copy_mapped` semantics.
+fn plan_large_uploads(
+    spans: impl Iterator<Item = (usize, usize)>,
+    jobs: &mut Vec<(usize, usize, usize)>,
+    tails: &mut Vec<(usize, usize, usize)>,
+) {
+    const BLOCK: usize = 8 << 20;
+    jobs.clear();
+    tails.clear();
+    for (index, (from, to)) in spans.enumerate() {
+        if to - from >= 32 << 20 {
+            let first_end = from + BLOCK;
+            jobs.push((index, from, first_end));
+            tails.push((index, first_end, to));
+        } else {
+            jobs.push((index, from, to));
+        }
+    }
+    while !tails.is_empty() {
+        tails.retain_mut(|(index, from, to)| {
+            let end = from.saturating_add(BLOCK).min(*to);
+            jobs.push((*index, *from, end));
+            *from = end;
+            end < *to
+        });
+    }
+}
