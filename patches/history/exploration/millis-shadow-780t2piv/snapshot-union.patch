+                    (p + 60, p + 72), (p + PAGE + 3, p + PAGE + 6)];
+        let mut ranges = decl.to_vec();
+        copy.snapshot_writes(&mut ranges);
+        assert_eq!(ranges, [(p + 11, p + 72), (p + PAGE + 3, p + PAGE + 6)]);
+        let before = copy.before.lock().unwrap();
