+    #[test]
+    fn three_way_merge_matches_each_byte_value() {
+        let mut title = vec![0u8; 65536];
+        let mut host = vec![0u8; 65536];
+        let mut before = vec![0u8; 65536];
+        for old in 0..=u8::MAX {
+            before.fill(old);
+            for (i, (t, h)) in title.iter_mut().zip(&mut host).enumerate() {
+                *t = (i >> 8) as u8;
+                *h = i as u8;
+            }
+            assert!(super::merge_gpu_bytes(&mut title, &mut host, &before));
+            for (i, (&t, &h)) in title.iter().zip(&host).enumerate() {
+                let gpu = i as u8;
+                let expected = if old == gpu { (i >> 8) as u8 } else { gpu };
+                assert_eq!((t, h), (expected, expected));
+            }
+            // Title and host now agree on every byte. The report must
+            // remain false even when the GPU differs from the baseline.
+            assert!(!super::merge_gpu_bytes(&mut title, &mut host, &before));
+        }
+    }
