     #[test]
+    fn a_failed_whole_page_does_not_hide_a_readable_overlap() {
+        use windows_sys::Win32::System::Memory::{PAGE_NOACCESS, VirtualProtect};
+        let p = crate::watch::tests::pool(1);
+        register(p, p as u64, PAGE as u64);
+        let copy = find(p as u64, PAGE as u64).expect("test requires a host GPU");
+        copy.update(p, PAGE);
+        copy.snapshot_writes(&mut vec![(p, p + PAGE), (p, p + 64)]);
+        copy.write_host((p + 3) as u64, &[17]);
+        let mut old = 0;
+        // SAFETY: within our page-aligned allocation, and protection is restored below.
+        unsafe { assert_ne!(VirtualProtect((p + 8192) as *mut _, 4096, PAGE_NOACCESS, &mut old), 0) };
+        assert_eq!(copy.copy_back(p, PAGE), 0);
+        assert_eq!(copy.copy_back(p, 64), 64);
+        assert_eq!(unsafe { ((p + 3) as *const u8).read_volatile() }, 17);
+        unsafe { assert_ne!(VirtualProtect((p + 8192) as *mut _, 4096, old, &mut old), 0) };
+        drop(copy);
+        unregister(p, p as u64);
+        crate::watch::tests::free(p);
+    }
