+    #[test]
+    fn overlapping_copybacks_preserve_later_title_writes_through_an_alias() {
+        let (p, alias) = crate::watch::tests::twin_views(1);
+        register(p, p as u64, PAGE as u64);
+        let copy = find(p as u64, PAGE as u64).expect("test requires a host GPU");
+        for (first, second) in [
+            ((p + 16, p + 64), (p + 20, p + 96)),
+            ((p + 16, p + 64), (p, p + PAGE)),
+            ((p, p + PAGE), (p + 20, p + 96)),
+        ] {
+            // SAFETY: each address is in the test's second live mapping.
+            let write = |at, value| unsafe { ((alias + at) as *mut u8).write_volatile(value) };
+            let read = |at| unsafe { ((alias + at) as *const u8).read_volatile() };
+            for at in [21usize, 23, 84] {
+                write(at, 0);
+            }
+            copy.update(p, PAGE);
+            copy.snapshot_writes(&mut vec![first, second]);
+            copy.write_host((p + 21) as u64, &[7]);
+            copy.write_host((p + 84) as u64, &[9]);
+            write(23, 1);
+            copy.copy_back(first.0, first.1 - first.0);
+            assert_eq!((read(21usize), read(23)), (7, 1));
+            // Both a previously GPU-written byte and an unrelated CPU byte
+            // acquire newer values after the first, overlapping return.
+            write(21, 0x43);
+            write(23, 0x44);
+            copy.copy_back(second.0, second.1 - second.0);
+            assert_eq!((read(21usize), read(23), read(84)), (0x43, 0x44, 9));
+        }
+        unregister(p, p as u64);
+    }
