+/// What lane `l` holds of `x`, read from another lane `from` (DPP,
+/// `v_permlane16`, `v_readlane`): a lane's own value of an earlier VGPR is
+/// that lane's only.
+fn moved(x: Sym, from: u32, l: u32) -> Sym {
+    match x {
+        Sym::Own(_) if from != l => Sym::Unknown,
+        _ => x,
+    }
+}
