+/// Whether lane-mask operation `f` (as [`Lanes::combine`] names it) leaves
+/// a lane clear where its operands `a` and `c` are known clear.
+fn keeps_clear(f: &str, a: bool, c: bool) -> bool {
+    match f {
+        "and" => a || c,
+        "or" | "xor" => a && c,
+        "andn2" => a,
+        "andn1" => c,
+        _ => false,
+    }
