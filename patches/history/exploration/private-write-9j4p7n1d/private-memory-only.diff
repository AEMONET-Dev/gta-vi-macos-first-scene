+/// A single committed private region with stable writable protection.
+fn private_write_range(address: usize, len: usize) -> bool {
+    use windows_sys::Win32::System::Memory::{
+        MEM_COMMIT, MEM_PRIVATE, MEMORY_BASIC_INFORMATION, PAGE_EXECUTE_READWRITE,
+        PAGE_READWRITE, VirtualQuery,
+    };
+    let Some(end) = address.checked_add(len) else { return false };
+    let mut info = MEMORY_BASIC_INFORMATION::default();
+    // SAFETY: only queries metadata; info is writable for the requested size.
+    let n = unsafe { VirtualQuery(address as *const _, &mut info, size_of_val(&info)) };
+    n != 0 && info.State == MEM_COMMIT && info.Type == MEM_PRIVATE
+        && matches!(info.Protect, PAGE_READWRITE | PAGE_EXECUTE_READWRITE)
+        && (info.BaseAddress as usize).saturating_add(info.RegionSize) >= end
 }
 
