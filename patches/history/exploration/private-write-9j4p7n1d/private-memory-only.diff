+    /// Subtract a title write from sorted, disjoint current coverage.
+    pub(crate) fn invalidate(&mut self, from: usize, to: usize) {
+        debug_assert!(self.requested.is_empty());
+        if from >= to { return; }
+        let first = self.current.partition_point(|&(_, end)| end <= from);
+        let last = first + self.current[first..].partition_point(|&(start, _)| start < to);
+        if first == last { return; }
+        let start = self.current[first].0;
+        let end = self.current[last - 1].1;
+        let left = (start < from).then_some((start, from));
+        let right = (to < end).then_some((to, end));
+        self.current.splice(first..last, left.into_iter().chain(right));
     }
 
