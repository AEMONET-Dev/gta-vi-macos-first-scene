From ca77ed74b0dafb54d06003738720dfc23702c051 Mon Sep 17 00:00:00 2001
From: AEMONET-Dev <267029939+AEMONET-Dev@users.noreply.github.com>
Date: Wed, 25 Nov 2026 21:35:51 -0500
Subject: [PATCH] shader: convert mesh export channels before stores (port
 VIctory-macOS#167)

Eliminates deterministic MTLCompilerService EXC_BAD_ACCESS /
XPC_ERROR_CONNECTION_INTERRUPTED crashes on Apple Silicon by converting
all mesh export channel values before emitting storeVertexOutput /
storePrimitiveOutput grouped by (element, channel).

Verified on M5 Max (GPTK 4.0b3) with VICTORY_FORCE_WAVE32=1 +
VICTORY_PACK_MESH_OUTPUTS=1: XPC errors dropped from 61-80 to 0 on both
cold and warm caches.
---
 crates/victory-shader/src/emit/lower.rs | 17 ++++++++++++++---
 1 file changed, 14 insertions(+), 3 deletions(-)

diff --git a/crates/victory-shader/src/emit/lower.rs b/crates/victory-shader/src/emit/lower.rs
index 5c6a560..a2ca912 100644
--- a/crates/victory-shader/src/emit/lower.rs
+++ b/crates/victory-shader/src/emit/lower.rs
@@ -9775,6 +9775,13 @@ impl<'a> Lower<'a> {
             (true, false) => ("storeVertexOutput", 171),
             (true, true) => ("storePrimitiveOutput", 172),
         };
+        // Every value first, then the stores, an element's channels side by
+        // side. Metal's DXIL converter (behind D3DMetal) makes one vector
+        // write of an element's channel stores, where the first of them is:
+        // a channel converted between two stores would be used there before
+        // it exists, which the converter does not notice and the Apple GPU
+        // compiler crashes on (upstream pragyaangaur/VIctory-macOS#167).
+        let mut ready = Vec::with_capacity(stores.len());
         for (id, col, value, half) in stores {
             let mut x = self.i32_of(value)?;
             if let Some(high) = half {
@@ -9803,15 +9810,19 @@ impl<'a> Lower<'a> {
                 }
                 _ => (".i32", x),
             };
+            ready.push((id, col, suffix, x));
+        }
+        let thread = (mesh && !ready.is_empty()).then(|| self.mesh_thread());
+        // Stable: two stores of one channel keep their order.
+        ready.sort_by_key(|&(id, col, ..)| (id, col));
+        for (id, col, suffix, x) in ready {
             let mut args = vec![
                 self.s.m.i32(id as u32),
                 self.s.m.i32(0),
                 self.s.m.i8(col),
                 x,
             ];
-            if mesh {
-                args.push(self.mesh_thread());
-            }
+            args.extend(thread);
             let void = self.s.t.void;
             self.s.op(
                 self.cur,
