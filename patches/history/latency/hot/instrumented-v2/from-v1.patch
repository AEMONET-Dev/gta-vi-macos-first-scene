+fn crossover(mode: &str, offset: Option<u64>) -> Option<bool> {
+    match mode {
+        "on" => Some(true),
+        "off" => Some(false),
+        "abba" | "baab" => Some(offset.is_some_and(|n| {
+            n >= 8 && (matches!(((n - 8) / 2) % 4, 1 | 2) == (mode == "abba"))
+        })),
+        _ => None,
     }
 }
+
+fn testing_snapshots() -> bool {
+    static SNAPSHOTS: OnceLock<bool> = OnceLock::new();
+    *SNAPSHOTS.get_or_init(|| std::env::var("VICTORY_LATENCY_SUBJECT").as_deref() == Ok("snapshots"))
+}
+
+pub(crate) fn xmem_enabled() -> bool {
+    static DEFAULT: OnceLock<bool> = OnceLock::new();
+    !testing_snapshots() && crossover(mode(), offset()).unwrap_or_else(|| {
+        *DEFAULT.get_or_init(|| crate::switch::on("VICTORY_XMEM_VIEW_READ"))
+    })
+}
+
+pub(crate) fn snapshots_enabled() -> bool {
+    static DEFAULT: OnceLock<bool> = OnceLock::new();
+    if testing_snapshots() && let Some(enabled) = crossover(mode(), offset()) {
+        return enabled;
+    }
+    *DEFAULT.get_or_init(|| crate::switch::on("VICTORY_MERGE_WRITE_SNAPSHOTS"))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::crossover;
+
+    #[test]
+    fn abba_and_baab_swap_only_after_warmup() {
+        assert_eq!(crossover("abba", None), Some(false));
+        assert_eq!(crossover("baab", Some(7)), Some(false));
+        for n in 8..32 {
+            let abba = matches!((n - 8) % 8, 2 | 3 | 4 | 5);
+            assert_eq!(crossover("abba", Some(n)), Some(abba));
+            assert_eq!(crossover("baab", Some(n)), Some(!abba));
+        }
+        assert_eq!(crossover("off", None), Some(false));
+        assert_eq!(crossover("on", None), Some(true));
+        assert_eq!(crossover("", Some(12)), None);
+    }
+}
