+/// A managed physical source may compare with and refresh a caller-owned host upload buffer.
+#[cfg(all(windows, feature="diagnostics"))]
+pub static XMEM_VIEW_REFRESH: std::sync::OnceLock<unsafe fn(usize,*mut u8,usize)->Option<usize>> = std::sync::OnceLock::new();
+
+/// Run disjoint upload comparisons on the same persistent workers as the submit path.
+#[cfg(all(windows,feature="diagnostics"))]
+pub fn compare_managed_spans<T: Sync>(spans: &[T], compare: impl Fn(&T)->usize + Sync) -> usize {
+    host::upload_jobs::run(spans, 4, compare)
