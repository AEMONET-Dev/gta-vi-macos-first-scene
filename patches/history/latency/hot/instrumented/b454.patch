+    }
+
+    struct Layout {
+        start: usize,
+        end: usize,
+        views: Vec<(usize, usize, usize)>, // clipped start, end, actual title allocation base
+        runs: Vec<ReadView>,
+    }
+
+    #[cfg(test)]
+    pub(super) static AFTER_COPY: std::sync::Mutex<Option<Box<dyn FnOnce() + Send>>> =
+        std::sync::Mutex::new(None);
+    static CURRENT: RwLock<Option<Arc<Layout>>> = RwLock::new(None);
+
+    // Call before changing a title mapping, while its physical registry is held. Acquiring
+    // the write lock only on overlap keeps unrelated mappings out of a buffer refresh.
+    pub(super) fn invalidate(start: usize, len: usize) {
+        let end = start.saturating_add(len);
+        if CURRENT.read().unwrap_or_else(|p| p.into_inner()).as_ref()
+            .is_some_and(|old| old.start < end && start < old.end)
+        {
+            CURRENT.write().unwrap_or_else(|p| p.into_inner()).take();
+        }
+    }
+
+    fn build(at: usize, end: usize, physical: &Physical) -> Option<Layout> {
+        let mut slices: Vec<(Slice, usize)> = Vec::new();
+        let mut views = Vec::new();
+        let mut cursor = at;
+        while cursor < end {
+            let (&base, (size, slice)) = physical.views.range(..=cursor).next_back()?;
+            let stop = end.min(base.checked_add(*size)?);
+            if stop <= cursor { return None; } // unregistered address, including holes
+            let index = slice.index + (cursor - base) / PAGE;
+            let count = (stop - cursor) / PAGE;
+            if let Some((prev, n)) = slices.last_mut()
+                && Arc::ptr_eq(&prev.section, &slice.section) && prev.index + *n == index
+            {
+                *n += count;
+            } else {
+                if slices.len() == 8 { return None; }
+                slices.push((Slice { section: slice.section.clone(), index }, count));
+            }
+            views.push((cursor, stop, base));
+            if views.len() > 32 { return None; }
+            cursor = stop;
+        }
+        let mut runs = Vec::new();
+        for (slice, count) in slices {
+            let offset = (slice.index * PAGE) as u64;
+            let len = count * PAGE;
+            // SAFETY: complete consecutive pages in a live section. This mapping itself holds
+            // the underlying section alive independently of future physical frees or remaps.
+            let mapping = unsafe { MapViewOfFile(slice.section.0, FILE_MAP_READ, (offset>>32) as u32, offset as u32, len) };
+            if mapping.Value.is_null() { return None; }
+            runs.push(ReadView { address: mapping.Value as usize, len });
+        }
+        Some(Layout { start: at, end, views, runs })
+    }
+
+    fn layout(at: usize, end: usize) -> Option<Arc<Layout>> {
+        if let Some(old) = CURRENT.read().unwrap_or_else(|p| p.into_inner()).as_ref()
+            && (old.start, old.end) == (at,end) { return Some(old.clone()); }
+        // Never wait for a title mapping while holding GPU submission locks.
+        let physical = PHYSICAL.try_lock().ok()?;
+        let new = Arc::new(build(at, end, &physical)?);
+        *CURRENT.write().unwrap_or_else(|p| p.into_inner()) = Some(new.clone());
+        Some(new)
+    }
+
+    fn readable(layout: &Layout) -> bool {
+        use windows_sys::Win32::System::Memory::{VirtualQuery, PAGE_READONLY, PAGE_WRITECOPY};
+        layout.views.iter().all(|&(begin,end,base)| {
+            let mut cursor = begin;
+            while cursor < end {
+                let mut info = MEMORY_BASIC_INFORMATION::default();
+                // SAFETY: only querying metadata; no guest byte is dereferenced here.
+                if unsafe { VirtualQuery(cursor as *const _, &mut info, size_of_val(&info)) } == 0
+                    || info.State != MEM_COMMIT || info.Type != MEM_MAPPED
+                    || info.AllocationBase as usize != base
+                    || !matches!(info.Protect, PAGE_READONLY | PAGE_READWRITE)
+                    || info.AllocationProtect == PAGE_WRITECOPY { return false; }
+                let next = (info.BaseAddress as usize).saturating_add(info.RegionSize).min(end);
+                if next <= cursor { return false; }
+                cursor = next;
+            }
+            true
+        })
+    }
+
+    // These read live foreign memory without constructing Rust references into memory a title
+    // thread may concurrently update. The GPU caller owns the host destination for the copy.
+    unsafe extern "C" {
+        fn memcpy(dst: *mut c_void, src: *const c_void, len: usize) -> *mut c_void;
+    }
+
+    // Cache-line equality, unaligned native words, no probabilistic fingerprint and no
+    // Rust references to mutable title mappings. Every caller supplies whole 64-byte lines.
+    unsafe fn equal(a: *const u8,b: *const u8,len:usize) -> bool {
+        for i in (0..len).step_by(64) {
+            let mut bits=0u128;
+            for lane in [0,16,32,48] {
+                unsafe { bits |= a.add(i+lane).cast::<u128>().read_unaligned() ^ b.add(i+lane).cast::<u128>().read_unaligned(); }
+            }
+            if bits != 0 { return false; }
+        }
+        true
+    }
+
+    /// Success after refreshing every byte, or None: redo the whole range with checked reads.
+    pub(super) unsafe fn refresh(at: usize, dst: *mut u8, len: usize) -> Option<usize> {
+        if len == 0 || !at.is_multiple_of(PAGE) || !len.is_multiple_of(PAGE) { return None; }
+        let layout = layout(at,at.checked_add(len)?)?;
+        if !readable(&layout) { return None; }
+        let mut offset = 0;
+        let mut spans = Vec::with_capacity(len / (4<<20) + layout.runs.len());
+        for run in &layout.runs {
+            for i in (0..run.len).step_by(4 << 20) {
+                spans.push((run.address + i, dst as usize + offset + i, (run.len-i).min(4<<20)));
+            }
+            offset += run.len;
+        }
+        let written = victory_gpu::compare_managed_spans(&spans, |&(src,dst,size)| {
+            let mut written = 0;
+            for i in (0..size).step_by(PAGE) {
+                let a = (src+i) as *const u8;
+                let b = (dst+i) as *mut u8;
+                // SAFETY: source mappings stay pinned in layout until all workers are joined;
+                // disjoint chunks in the currently idle host buffer have a single writer.
+                unsafe {
+                    if equal(a,b,PAGE) { continue; }
+                    for k in (0..PAGE).step_by(4096) {
+                        if !equal(a.add(k),b.add(k),4096) {
+                            memcpy(b.add(k).cast(),a.add(k).cast(),4096);
+                            written += 4096;
+                        }
+                    }
+                }
+            }
+            written
+        });
+        #[cfg(test)]
+        if let Some(change_mapping) = AFTER_COPY.lock().unwrap().take() {
+            change_mapping();
+        }
+        // A known identity change during comparison demands a complete retry, even if some
+        // changed pages had already reached dst. All title reads that fail use the old path.
+        if !CURRENT.read().unwrap_or_else(|p| p.into_inner()).as_ref().is_some_and(|old| Arc::ptr_eq(old,&layout))
+            || !readable(&layout) { return None; }
+        Some(written)
+    }
+}
