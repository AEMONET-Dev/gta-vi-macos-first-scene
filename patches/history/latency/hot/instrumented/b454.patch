+use std::{sync::OnceLock, time::Instant};
+
+fn origin() -> Instant {
+    static ORIGIN: OnceLock<Instant> = OnceLock::new();
+    *ORIGIN.get_or_init(Instant::now)
+}
+pub(crate) fn stamp() -> Instant {
+    origin();
+    Instant::now()
+}
+pub(crate) fn us(stamp: Instant) -> u64 {
+    stamp.saturating_duration_since(origin()).as_micros() as u64
+}
+fn mode() -> &'static str {
+    static MODE: OnceLock<String> = OnceLock::new();
+    MODE.get_or_init(|| std::env::var("VICTORY_LATENCY_MODE").unwrap_or_default())
+}
+#[cfg(feature = "diagnostics")]
+pub(crate) fn offset() -> Option<u64> {
+    crate::capture::world_frame().map(|w| crate::queue::presented().saturating_sub(w))
+}
+#[cfg(not(feature = "diagnostics"))]
+pub(crate) fn offset() -> Option<u64> { None }
+pub(crate) fn recording() -> bool {
+    !mode().is_empty() && offset().is_some_and(|n| n < 62)
+}
+pub(crate) fn xmem_enabled() -> bool {
+    match mode() {
+        "on" => true,
+        "abba" | "baab" => offset().is_some_and(|n|
+            n >= 8 && (matches!(((n - 8) / 2) % 4, 1 | 2) == (mode() == "abba"))),
+        "off" => false,
+        _ => {
+            static DEFAULT: OnceLock<bool> = OnceLock::new();
+            *DEFAULT.get_or_init(|| crate::switch::on("VICTORY_XMEM_VIEW_READ"))
+        },
+    }
+}
