+    /// Capture the final host values once for the union of sorted declarations.
+    /// Keep the original keys because command lists release those exact ranges.
+    pub(crate) fn snapshot_declarations(
+        &self,
+        ranges: impl Iterator<Item = (usize, usize)> + Clone,
+    ) {
+        self.pending
+            .lock()
+            .unwrap_or_else(|e| e.into_inner())
+            .extend(ranges.clone().map(|(at, len)| (at, at + len)));
+        let mut spans = ranges.filter(|&(_, len)| len != 0);
+        let Some((mut start, len)) = spans.next() else { return };
+        let mut end = start + len;
+        for (at, len) in spans {
+            if at > end {
+                self.snapshot(start, end - start);
+                start = at;
+                end = at + len;
+            } else {
+                end = end.max(at + len);
+            }
+        }
+        self.snapshot(start, end - start);
+    }
