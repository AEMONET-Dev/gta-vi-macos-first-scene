+    #[test]
+    fn merged_declarations_preserve_gaps_and_original_release_keys() {
+        let p = crate::watch::tests::pool(2);
+        register(p, p as u64, (2 * PAGE) as u64);
+        let Some(shadow) = find(p as u64, (2 * PAGE) as u64) else {
+            unregister(p, p as u64);
+            return;
+        };
+        shadow.update(p, 2 * PAGE);
+        let spans = [(p, 32), (p + 16, 32), (p + 48, 8), (p + 60, 0), (p + PAGE, 12)];
+        shadow.snapshot_declarations(spans.into_iter());
+        {
+            let before = shadow.before.lock().unwrap();
+            let segments: Vec<_> = before.0.iter().map(|(at, v)| (*at, v.len())).collect();
+            assert_eq!(segments, [(0, 56), (PAGE, 12)]);
+        }
