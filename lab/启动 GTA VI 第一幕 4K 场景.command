#!/bin/zsh
set -eu
export VICTORY_PICTURE_EDITION=world VICTORY_PICTURE_CONSOLE=series-x
export VICTORY_MATERIAL_LIGHT=0 VICTORY_MATERIAL_EARLY_SCENE=0
export VICTORY_MATERIAL_SURFACES=0 VICTORY_SPATIAL_UPSCALE=0
export VICTORY_PRESENT_COMPOSITE=1 VICTORY_WORLD_RENDER_MODE="${VICTORY_WORLD_RENDER_MODE:-0}"
unset VICTORY_PICTURE_EXPERIMENT VICTORY_PICTURE_PARALLEL
exec "${0:A:h}/启动 GTA VI 第一幕材质渲染.command"
