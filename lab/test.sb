(version 1)
(allow default)
(deny file-write*)
(allow file-write* (subpath (param "WORKSPACE")))
(allow file-write* (subpath (param "WINE_TMP")))
(allow file-write* (literal "/dev/null") (literal "/dev/tty"))
(deny network-outbound (remote ip))
(allow file-write* (subpath (string-append (param "DARWIN_CACHE") "/d3dm/victory.exe")))
(allow file-write* (subpath (string-append (param "DARWIN_CACHE") "/d3dm/xcl.exe")))
(allow file-write* (subpath (string-append (param "DARWIN_TEMP") "/com.apple.MetalPerformanceShadersGraph")))
(allow file-write* (subpath (string-append (param "DARWIN_CACHE") "/d3dm/device_check.exe")))
(allow file-write* (subpath (string-append (param "DARWIN_CACHE") "/com.codeweavers.CrossOver.wineloader/com.apple.metal")))
(allow file-write* (subpath (string-append (param "DARWIN_CACHE") "/com.codeweavers.CrossOver.wineloader/com.apple.metalfe")))
(allow file-write* (regex (param "TEMP_ITEM_REGEX")))
